{
  "expo": {
    "name": "Honey, Dinner?",
    "slug": "honey-dinner",
    "scheme": "honeydinner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shakeandbakelabs.honeydinner",
      "buildNumber": "25",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Honey, Dinner? uses the camera to scan your fridge, receipts and cookbook pages.",
        "NSPhotoLibraryUsageDescription": "Honey, Dinner? uses your photos to scan fridge shelves and receipts, and to import recipes from screenshots and cookbook pictures."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.shakeandbakelabs.honeydinner",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "./plugins/withPodDeploymentTarget.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#F4EDE0"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Honey, Dinner? uses the camera to scan your fridge, receipts and cookbook pages."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Honey, Dinner? uses your photos to scan fridge shelves and receipts, and to import recipes from screenshots and cookbook pictures."
        }
      ],
      [
        "./plugins/with-share-extension-name",
        {
          "displayName": "Honey, Dinner?"
        }
      ],
      "./plugins/with-share-extension-fixes",
      [
        "expo-share-extension",
        {
          "activationRules": [
            {
              "type": "url",
              "max": 1
            },
            {
              "type": "text"
            }
          ],
          "backgroundColor": {
            "red": 0,
            "green": 0,
            "blue": 0,
            "alpha": 0
          },
          "height": 620,
          "excludedPackages": [
            "expo-dev-client",
            "expo-splash-screen",
            "expo-updates",
            "expo-camera",
            "react-native-vision-camera",
            "expo-speech-recognition"
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Honey, Dinner? listens for \u201cnext\u201d, \u201cback\u201d and \u201cstart timer\u201d so you can cook hands-free.",
          "speechRecognitionPermission": "Honey, Dinner? understands voice commands like \u201cnext step\u201d while you cook."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "606db703-82ec-4e7a-96cf-d0045dc84566"
      }
    },
    "owner": "thamerhannonas-organization"
  }
}
