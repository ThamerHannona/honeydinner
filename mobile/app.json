{
  "expo": {
    "name": "Honey, Dinner?",
    "slug": "honey-dinner",
    "scheme": "honeydinner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shakeandbakelabs.honeydinner",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Honey, Dinner? uses the camera to scan your fridge, receipts and cookbook pages.",
        "NSPhotoLibraryUsageDescription": "Honey, Dinner? uses your photos to import recipes from screenshots and cookbook pictures."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.shakeandbakelabs.honeydinner",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "./plugins/withPodDeploymentTarget.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F4EDE0"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Honey, Dinner? uses the camera to scan your fridge, receipts and cookbook pages."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Honey, Dinner? uses your photos to import recipes from screenshots and cookbook pictures."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "606db703-82ec-4e7a-96cf-d0045dc84566"
      }
    },
    "owner": "thamerhannonas-organization"
  }
}
